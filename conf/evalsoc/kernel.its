/*
 * Simple U-Boot uImage source file containing a single kernel and FDT blob
 */
/dts-v1/;

/ {
    description = "Simple image with single Linux kernel and FDT blob";
    #address-cells = <1>;

    images {
        kernel {
            description = "Linux kernel";
            data = /incbin/("Image.lz4");
            type = "kernel";
            arch = "riscv";
            os = "linux";
            compression = "lz4";
            load = <0x80400000>;
            entry = <0x80400000>;
            cipher {
                algo = "aes256";
                key-name-hint = "aes256key_uboot";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "uboot";
            };
        };
        ramdisk{
            description = "Ramdisk";
            data = /incbin/("Initrd.lz4");
            type = "ramdisk";
            arch = "riscv";
            os = "linux";
            load = <0x0>;
            entry = <0x0>;
            cipher {
                algo = "aes256";
                key-name-hint = "aes256key_uboot";
            };
            signature {
                algo = "sha256,rsa2048";
                key-name-hint = "uboot";
            };
        };
    };

    configurations {
        default = "conf-1";
        conf-1 {
            description = "Boot Linux kernel with FDT blob";
            kernel = "kernel";
            ramdisk = "ramdisk";
        };
    };
};
